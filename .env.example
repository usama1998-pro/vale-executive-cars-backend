NODE_ENV=development
PORT=3001
HOST=0.0.0.0

TZ=Europe/London

JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=7d

APP_URL=http://localhost:3001

# Winston file logging (admin: GET /logs, GET /logs/files)
LOG_FILE_ENABLED=true
LOG_FILE=logs/app.log
LOG_FILE_MAX_SIZE=10mb
LOG_FILE_MAX_FILES=5
LOG_CONSOLE=true
LOG_LEVEL=info

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=vale
DATABASE_PASSWORD=vale
DATABASE_NAME=vale_executives_cars
# DATABASE_ROOT_PASSWORD=vale_root

# Staff admin bootstrap (email + password only). Runs after migrations on:
#   npm run build  |  npm run migrate:deploy  |  npm run ensure-admin-from-env
# Leave both unset to skip. Idempotent: safe on every deploy (won't recreate if admin exists).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-8-chars-min

# Meta WhatsApp Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=
# Optional: exchange short-lived user token before send (not needed for permanent/system user tokens)
# META_APP_ID=
# META_APP_SECRET=
# WHATSAPP_SKIP_TOKEN_EXCHANGE=true
# WHATSAPP_TOKEN_REFRESH_ENABLED=true
# META_TOKEN_REFRESH_BUFFER_SECONDS=86400
# Must match the language shown in WhatsApp Manager for your template (e.g. en_US or en_GB)
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Full messages endpoint (preferred):
FACEBOOK_GRAPH_API=https://graph.facebook.com/v25.0/YOUR_PHONE_NUMBER_ID/messages
# Or build URL from:
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_BUSINESS_NAME=Vale Executives Cars
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Customer `contactNumber` → WhatsApp `to` (UK 0… → 44…, PK → 92…)
WHATSAPP_DEFAULT_COUNTRY_CODE=44
# Owner/business number — all booking WhatsApp alerts go here (not the customer)
WHATSAPP_TO=923424399056
